#!/bin/zsh -f
# ceremony zai shim — run eval sessions on the Z.AI (GLM) backend via the
# same provider env as the user's zai() shell function (~/.zsh_functions).
#
# Deliberately reproduces ONLY the provider env (ANTHROPIC_BASE_URL,
# ANTHROPIC_AUTH_TOKEN, model overrides). zai()'s interactive flags
# (--allow-dangerously-skip-permissions, --effort max) are NOT passed:
# eval protocol requires bounded, condition-identical permissions
# (acceptEdits + allowlist) — see docs/plans/tasks-005 protocol section.
#
# Values never leave the process boundary: this shim only moves env from
# the zsh config into the spawned claude process.
source "$HOME/.zsh_functions" >/dev/null 2>&1

if [[ -z "$ZAI_API_URL" || -z "$ZAI_API_KEY" ]]; then
  echo "zai shim: ZAI_* provider env not resolvable (sourced ~/.zsh_functions)" >&2
  exit 9
fi

export ANTHROPIC_BASE_URL="$ZAI_API_URL" \
       ANTHROPIC_AUTH_TOKEN="$ZAI_API_KEY" \
       ANTHROPIC_MODEL="$ZAI_MODEL" \
       ANTHROPIC_DEFAULT_OPUS_MODEL="$ZAI_MODEL_REASONING" \
       ANTHROPIC_DEFAULT_SONNET_MODEL="$ZAI_MODEL" \
       ANTHROPIC_DEFAULT_HAIKU_MODEL="$ZAI_MODEL_SMALL_FAST" \
       ANTHROPIC_SMALL_FAST_MODEL="$ZAI_MODEL_SMALL_FAST"

exec claude "$@"
