#!/bin/zsh -f
# ceremony zai shim — run eval sessions on a Z.AI (GLM) backend.
#
# Some provider setups authenticate claude through environment variables
# rather than a logged-in config. This shim sources the local zsh config to
# pick up ZAI_* provider variables, maps them to the ANTHROPIC_* names claude
# reads, and execs claude. Adapt the source line or variable names for your
# own provider setup.
#
# Provider env only (ANTHROPIC_BASE_URL, ANTHROPIC_AUTH_TOKEN, model
# overrides). No permission bypass and no effort override: eval protocol
# requires bounded, condition-identical permissions (acceptEdits + allowlist;
# see docs/plans/tasks-005 protocol section).
#
# Secrets move process-to-process only; nothing is logged.
source "$HOME/.zsh_functions" >/dev/null 2>&1

if [[ -z "$ZAI_API_URL" || -z "$ZAI_API_KEY" ]]; then
  echo "zai shim: ZAI_* provider env not resolvable (sourced ~/.zsh_functions)" >&2
  exit 9
fi

export ANTHROPIC_BASE_URL="$ZAI_API_URL" \
       ANTHROPIC_AUTH_TOKEN="$ZAI_API_KEY" \
       ANTHROPIC_MODEL="$ZAI_MODEL" \
       ANTHROPIC_DEFAULT_OPUS_MODEL="$ZAI_MODEL_REASONING" \
       ANTHROPIC_DEFAULT_SONNET_MODEL="$ZAI_MODEL" \
       ANTHROPIC_DEFAULT_HAIKU_MODEL="$ZAI_MODEL_SMALL_FAST" \
       ANTHROPIC_SMALL_FAST_MODEL="$ZAI_MODEL_SMALL_FAST"

exec claude "$@"
